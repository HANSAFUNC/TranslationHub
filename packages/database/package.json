{
  "name": "@localehub/database",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "generate": "prisma generate",
    "migrate:dev": "node ../../scripts/run-with-env.mjs --database-url-var MIGRATE_DATABASE_URL prisma migrate dev",
    "migrate:deploy": "node ../../scripts/run-with-env.mjs --database-url-var MIGRATE_DATABASE_URL prisma migrate deploy",
    "migrate:reset": "node ../../scripts/run-with-env.mjs --database-url-var MIGRATE_DATABASE_URL prisma migrate reset --force",
    "setup": "node ../../scripts/run-with-env.mjs --database-url-var MIGRATE_DATABASE_URL prisma migrate deploy && prisma generate",
    "seed": "node dist/seed.js",
    "studio": "node ../../scripts/run-with-env.mjs prisma studio"
  },
  "dependencies": {
    "@localehub/contracts": "workspace:*",
    "@prisma/client": "^6.1.0"
  },
  "devDependencies": {
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
