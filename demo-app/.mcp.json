{
  "mcpServers": {
    "localehub-local": {
      "command": "node",
      "args": ["../apps/mcp-local/dist/bin.js", "--stdio", "--workspace", "."],
      "env": {
        "LOCALEHUB_API_URL": "http://localhost:3001/api/v1",
        "LOCALEHUB_WORKSPACE": ".",
        "LOCALEHUB_TOKEN": "${LOCALEHUB_TOKEN}"
      }
    }
  }
}
