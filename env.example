# ---------------------------------------------------------------------------
# LocaleHub environment template.
#
# NOTE ON THE FILENAME: this workspace denies reads/writes of `.env*` paths, so the
# template ships as `env.example` and the dev values as `localehub.env`. The config
# loader (@localehub/config) reads, in order:
#     1. $LOCALEHUB_ENV_FILE
#     2. .env            (if the environment allows it)
#     3. localehub.env
# Copy this file to `.env` on a normal workstation, or to `localehub.env` here.
#
# Production deployments must inject secrets from a secret manager / *_FILE
# variables instead of committing them (see docs/DEPLOYMENT.md).
# ---------------------------------------------------------------------------

NODE_ENV=development

# --- URLs -------------------------------------------------------------------
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:3001/api/v1
API_PORT=3001
WEB_PORT=3000
WORKER_PORT=3002
MCP_REMOTE_PORT=3003
# Allowed browser origins. Used by both the CORS middleware and the CSRF guard, so a configured
# value here is also what the guard will accept as `Origin` on state-changing requests.
# Defaults to http://localhost:3000 when unset (or empty).
CORS_ORIGINS=http://localhost:3000
# Leave unset to have the browser call the API on its own origin (recommended: the session cookie
# stays first-party). Set it only when the API lives on a different host than the web app.
# NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1

# --- transport / browser session -------------------------------------------
# Express `trust proxy`: false (default), true, or a hop count. Only turn this on when a reverse
# proxy really is in front — otherwise X-Forwarded-For can be spoofed to dodge rate limits.
TRUST_PROXY=false
# Refuse credentials over plain HTTP when NODE_ENV=production. Set to true only if a TLS-terminating
# hop you control already protects the connection to this process.
# ALLOW_INSECURE_HTTP=false
SESSION_COOKIE_NAME=localehub_session
CSRF_COOKIE_NAME=localehub_csrf
CSRF_HEADER_NAME=x-csrf-token

# --- rate limiting ----------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
# Requests per window for an authenticated actor (interactive session or MCP token).
RATE_LIMIT_MAX=600
# Requests per window for one (IP, account) pair on /auth/login and /auth/register. A second,
# looser bucket per IP (5x) stops password spraying without locking out everyone behind one NAT.
RATE_LIMIT_AUTH_MAX=12

# --- database ---------------------------------------------------------------
# The application connects with a non-owner role so that RLS is enforced.
DATABASE_URL=postgresql://localehub_app:localehub@127.0.0.1:55432/localehub?schema=public
# Migrations run as the owner (Prisma needs DDL rights and a shadow database).
MIGRATE_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55432/localehub?schema=public
TEST_DATABASE_URL=postgresql://localehub_app:localehub@127.0.0.1:55432/localehub_test?schema=public
MIGRATE_TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55432/localehub_test?schema=public

# --- redis / queue ----------------------------------------------------------
REDIS_URL=redis://127.0.0.1:56379

# --- secrets (dev only values; override in every real environment) ----------
AUTH_SECRET=dev-only-auth-secret-change-me
ENCRYPTION_KEY=dev-only-encryption-key-change-me
# In production use AUTH_SECRET_FILE=/run/secrets/auth_secret instead:
# AUTH_SECRET_FILE=
# ENCRYPTION_KEY_FILE=
# DATABASE_URL_FILE=
# REDIS_URL_FILE=

# --- MCP --------------------------------------------------------------------
MCP_REMOTE_ENABLED=true
# Externally reachable URL of the Remote MCP; surfaced in the Web UI and in `mcp-config`.
# Behind nginx this is https://<host>/mcp.
MCP_PUBLIC_URL=http://localhost:3003/mcp
MCP_LOCAL_PACKAGE_NAME=@localehub/mcp-local
# Local MCP reads the platform token from this environment variable name by default:
LOCALEHUB_TOKEN=
LOCALEHUB_API_URL=http://localhost:3001/api/v1
LOCALEHUB_WORKSPACE=

# --- AI ---------------------------------------------------------------------
AI_DEFAULT_POLICY=hybrid
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434

# --- object storage (optional) ---------------------------------------------
OBJECT_STORAGE_PROVIDER=local
S3_ENDPOINT=
S3_BUCKET=localehub
S3_REGION=ap-northeast-1
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- sync limits ------------------------------------------------------------
SYNC_PLAN_TTL_SECONDS=1800
SYNC_MAX_ENTRIES_PER_BATCH=20000
