{
  "name": "@localehub/api",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "dev": "node -r ts-node/register/transpile-only src/main.ts",
    "start": "node dist/main.js",
    "openapi": "node dist/openapi/generate.js ../../docs/openapi.json"
  },
  "dependencies": {
    "@localehub/config": "workspace:*",
